# OpenAI-compatible endpoint for semantic triplet extraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=2
LLM_RETRY_SLEEP_SECONDS=2
SEMANTIC_MAX_CHARS=2500

# Optional OpenAI-compatible embedding endpoint.
# Leave these empty when using the local sentence_transformers backend.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Optional local model/cache settings.
# HF_TOKEN=your_huggingface_token
# HF_HOME=/path/to/huggingface/cache
GRAPHRAG_DEVICE=auto

# Optional path overrides used by the legacy extraction scripts.
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_TRIPLETS_DIR=./data/triplets
ONTOLOGY_SCHEMA=./ontology/schema.json
