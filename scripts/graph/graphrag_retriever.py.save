import argparse
import json
import pickle
import re
from pathlib import Path


def load_graph_index(index_path="indexes/graph/graph_index.pkl"):
    with open(index_path, "rb") as f:
        return pickle.load(f)


def normalize_text(text):
    return " ".join(str(text or "").split())


def parse_reference(reference):
    """
    Contoh reference:
    - Pasal 94 ayat (5)
    - PP 48 Tahun 2008, ... Pasal 32
    - PP 4 Tahun 2022 ... Pasal 5 ayat (2)
    """
    ref = str(reference or "")

    reg_match = re.search(
        r"(PP|UU|UUD)\s+(\d+)?\s*Tahun\s*(\d{4})",
        ref,
        flags=re.IGNORECASE,
    )

    pasal_match = re.search(
        r"Pasal\s+([0-9A-Za-z]+)",
        ref,
        flags=re.IGNORECASE,
    )

    ayat_match = re.search(
        r"ayat\s*\(?([0-9A-Za-z]+)\)?",
        ref,
        flags=re.IGNORECASE,
    )

    regulasi_id = None
    if reg_match:
        jenis = reg_match.group(1).upper()
        nomor = reg_match.group(2)
        tahun = reg_match.group(3)

        if jenis == "UUD":
            regulasi_id = "REG-UUD-1945"
        elif nomor:
            regulasi_id = f"REG-{jenis}-{nomor}-{tahun}"

    pasal = pasal_match.group(1) if pasal_match else None
    ayat = ayat_match.group(1) if ayat_match else None

    return {
        "regulasi_id": regulasi_id,
        "pasal": pasal,
        "ayat": ayat,
    }


def find_nodes_by_reference(graph, reference):
    parsed = parse_reference(reference)
    regulasi_id = parsed["regulasi_id"]
    pasal = parsed["pasal"]
    ayat = parsed["ayat"]

    matches = []

    if regulasi_id and pasal and ayat:
        exact_id = f"PSL-{regulasi_id}-{pasal}-{ayat}"
        if exact_id in graph:
            return [exact_id]

    if regulasi_id and pasal:
        prefix = f"PSL-{regulasi_id}-{pasal}-"
        for node_id in graph.nodes:
            if node_id.startswith(prefix):
                matches.append(node_id)

    if matches:
        return sorted(matches)

    if regulasi_id and regulasi_id in graph:
        return [regulasi_id]

    return []


def keyword_score(query, node_id, attrs):
    query = str(query or "").lower()
    text = str(attrs.get("text", "")).lower()
    title = str(attrs.get("title", "")).lower()
    node_id_l = node_id.lower()

    stopwords = {
        "apa", "yang", "harus", "dalam", "dan", "atau", "di", "ke", "dari",
        "untuk", "pada", "dengan", "sebagai", "terkait", "bagaimana",
        "siapa", "kapan", "dimana", "mengapa", "adalah", "itu"
    }

    tokens = [
        t for t in re.findall(r"[a-zA-Z0-9]+", query)
        if len(t) > 2 and t not in stopwords
    ]

    score = 0
    for token in tokens:
        if token in text:
            score += 2
        if token in title:
            score += 3
        if token in node_id_l:
            score += 1

    text_len_penalty = min(len(text) / 3000, 2)
    score = score - text_len_penalty

    return score


def fallback_keyword_search(graph, query, top_k=3):
    candidates = []

    for node_id, attrs in graph.nodes(data=True):
        if not attrs.get("text"):
            continue
        score = keyword_score(query, node_id, attrs)
        if score > 0:
            candidates.append((score, node_id))

    candidates.sort(reverse=True, key=lambda x: x[0])
    return [node_id for _, node_id in candidates[:top_k]]


def add_context_node(graph, node_id, selected, seen, relation):
    if node_id in seen or node_id not in graph:
        return

    attrs = graph.nodes[node_id]
    text = normalize_text(attrs.get("text", ""))

    if not text:
        return

    seen.add(node_id)
    selected.append({
        "node_id": node_id,
        "relation": relation,
        "type": attrs.get("type"),
        "regulasi_id": attrs.get("regulasi_id"),
        "nomor_pasal": attrs.get("nomor_pasal"),
        "nomor_ayat": attrs.get("nomor_ayat"),
        "text": text,
    })


def expand_context(graph, seed_nodes, max_context=5):
    selected = []
    seen = set()

    priority_predicates = {
        "MENGACU_PADA",
        "MENGAMANDEMEN",
        "MENGUBAH",
        "MEMILIKI_PASAL",
        "MENGATUR_TOPIK",
    }

    for seed in seed_nodes:
        add_context_node(graph, seed, selected, seen, "SEED")

        neighbors = []

        for _, target, edge_data in graph.out_edges(seed, data=True):
            predicate = edge_data.get("predicate", "")
            priority = 0 if predicate in priority_predicates else 1
            neighbors.append((priority, predicate, target))

        for source, _, edge_data in graph.in_edges(seed, data=True):
            predicate = edge_data.get("predicate", "")
            priority = 0 if predicate in priority_predicates else 1
            neighbors.append((priority, predicate, source))

        neighbors.sort(key=lambda x: x[0])

        for _, predicate, neighbor in neighbors:
            if len(selected) >= max_context:
                break
            add_context_node(graph, neighbor, selected, seen, predicate)

        if len(selected) >= max_context:
            break

    return selected[:max_context]


def format_reference(item):
    if item.get("type") == "PASAL" and item.get("regulasi_id"):
        return (
            f"{item.get('regulasi_id')} "
            f"Pasal {item.get('nomor_pasal')} "
            f"ayat {item.get('nomor_ayat')}"
        )
    return item["node_id"]


def build_context_text(context_nodes, max_chars_per_node=1200):
    parts = []

    for idx, item in enumerate(context_nodes, start=1):
        text = item["text"]
        if len(text) > max_chars_per_node:
            text = text[:max_chars_per_node].rstrip() + "..."

        parts.append(
            f"[Konteks {idx}]\n"
            f"Relasi: {item['relation']}\n"
            f"Referensi: {format_reference(item)}\n"
            f"Teks: {text}"
        )

    return "\n\n".join(parts)


def retrieve_graphrag_context(
    graph,
    query,
    reference="",
    top_k=3,
    max_context=5,
    max_chars_per_node=1200,
):
    seed_nodes = find_nodes_by_reference(graph, reference)

    if not seed_nodes:
        seed_nodes = fallback_keyword_search(graph, query, top_k=top_k)

    seed_nodes = seed_nodes[:top_k]
    context_nodes = expand_context(graph, seed_nodes, max_context=max_context)
    context_text = build_context_text(context_nodes, max_chars_per_node=max_chars_per_node)

    return {
        "seed_nodes": seed_nodes,
        "context_nodes": context_nodes,
        "context_text": context_text,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--query", required=True)
    parser.add_argument("--reference", default="")
    parser.add_argument("--index", default="indexes/graph/graph_index.pkl")
    parser.add_argument("--top_k", type=int, default=3)
    parser.add_argument("--max_context", type=int, default=5)
    args = parser.parse_args()

    index = load_graph_index(args.index)
    graph = index["graph"]

    result = retrieve_graphrag_context(
        graph=graph,
        query=args.query,
        reference=args.reference,
        top_k=args.top_k,
        max_context=args.max_context,
    )

    print("=== SEED NODES ===")
    for node_id in result["seed_nodes"]:
        print(node_id)

    print("\n=== GRAPH CONTEXT ===")
    print(result["context_text"])


if __name__ == "__main__":
    main()
